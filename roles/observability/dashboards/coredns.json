      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Upstream healthcheck failures",
          "description": "CoreDNS exports no per-upstream alive gauge; failing health checks mark an upstream unhealthy.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
