{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {"id": 1, "title": "CPU utilization", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{host=\"$host\",mode=\"idle\"}[$__rate_interval])) * 100)"}]},
    {"id": 2, "title": "Load (1m)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "targets": [{"expr": "node_load1{host=\"$host\"}"}]},
    {"id": 3, "title": "Memory used", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{host=\"$host\"} / node_memory_MemTotal_bytes{host=\"$host\"})"}]},
    {"id": 4, "title": "Swap used", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "100 * (1 - node_memory_SwapFree_bytes{host=\"$host\"} / node_memory_SwapTotal_bytes{host=\"$host\"})"}]},
    {"id": 5, "title": "Filesystem used", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{host=\"$host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{host=\"$host\",fstype!~\"tmpfs|overlay\"})"}]},
    {"id": 6, "title": "Inodes used", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "100 * (1 - node_filesystem_files_free{host=\"$host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_files{host=\"$host\",fstype!~\"tmpfs|overlay\"})"}]},
    {"id": 7, "title": "Network receive", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "targets": [{"expr": "sum by (device) (rate(node_network_receive_bytes_total{host=\"$host\",device!=\"lo\"}[$__rate_interval])) * 8"}]},
    {"id": 8, "title": "Network transmit", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "targets": [{"expr": "sum by (device) (rate(node_network_transmit_bytes_total{host=\"$host\",device!=\"lo\"}[$__rate_interval])) * 8"}]},
    {"id": 9, "title": "Selected systemd units", "type": "table", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "targets": [{"expr": "node_systemd_unit_state{host=\"$host\",state=\"active\",name=~\"(nginx|grafana|victoriametrics|headscale|stalwart(-mail)?|miniflux).*\"}"}]},
    {"id": 10, "title": "Scrape target state", "type": "status-history", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "targets": [{"expr": "up{host=\"$host\"}"}]},
    {"id": 11, "title": "Scrape duration", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "scrape_duration_seconds{host=\"$host\"}"}]},
    {"id": 12, "title": "Samples scraped", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "targets": [{"expr": "scrape_samples_scraped{host=\"$host\"}"}]}
